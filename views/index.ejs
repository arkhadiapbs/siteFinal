<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Arkhadia é um universo digital para gamers: jogos, comunidade, marketplace e novas experiências.">
  <title>Arkhadia</title>
</head>
<body>
  <%- include('partials/header', {title: 'Início'}); %>

  <main>

    <!-- Sessão de boas-vindas -->
    <section class="intro">
      <div class="intro-text">
        <h2><strong>BEM-VINDOS</strong></h2>
        <p>Arkhadia é um universo digital para quem vive e respira jogos. Aqui você encontra diversão, conexão e novas experiências.</p>
      </div>
    </section>

    <!-- Seções ZigZag -->
    <section class="zigzag">
      <div class="text">
        <h3>🎮 Explore Mundos Fantásticos</h3>
        <p>Descubra universos únicos criados por jogadores e desenvolvedores independentes.</p>
      </div>
      <div class="image">
        <img src="/images/jogo1.jpg" alt="Cenário de um jogo com mundos fantásticos">
      </div>
    </section>

    <section class="zigzag reverse">
      <div class="text">
        <h3>🛒 Marketplace de Itens</h3>
        <p>Compre, venda e troque itens digitais únicos, skins e acessórios raros.</p>
      </div>
      <div class="image">
        <img src="/images/marketplace.jpg" alt="Marketplace de itens digitais e skins">
      </div>
    </section>

    <section class="zigzag">
      <div class="text">
        <h3>💬 Comunidade Ativa</h3>
        <p>Participe de fóruns, eventos e votações. Sua voz molda o futuro da plataforma.</p>
      </div>
      <div class="image">
        <img src="/images/comunidade.jpg" alt="Grupo de jogadores interagindo na comunidade">
      </div>
    </section>

    <section class="zigzag reverse">
      <div class="text">
        <h3>📈 Evolução Constante</h3>
        <p>Atualizações frequentes, novos jogos e experiências exclusivas para os membros.</p>
      </div>
      <div class="image">
        <img src="/images/evolucao.jpg" alt="Gráfico representando evolução e progresso da plataforma">
      </div>
    </section>

  </main>

  <footer>
    © 2025 Arkhadia - Todos os direitos reservados
  </footer>

</body>
</html>